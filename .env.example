# --- Cloud LLM (generation path) ---
# The Anthropic SDK reads ANTHROPIC_API_KEY directly from the environment.
ANTHROPIC_API_KEY=sk-ant-...

# --- DocsMind settings (env_prefix = DOCSMIND_) ---
# Generation policy. "router" uses self-hosted vLLM first and Anthropic only
# when vLLM has a timeout, connection error, rate limit, or server error.
DOCSMIND_LLM_PROVIDER=router
DOCSMIND_LLM_PRIMARY_PROVIDER=vllm
DOCSMIND_LLM_FALLBACK_PROVIDER=cloud

# Generation model. Default is the most capable Opus tier; switch to
# claude-haiku-4-5 or claude-sonnet-4-6 for cheaper high-volume benchmarking.
DOCSMIND_CLOUD_LLM_MODEL=claude-opus-4-8

# Authenticated self-hosted generation through vLLM's OpenAI-compatible API.
# Keep the real endpoint and key only in .env or the process environment.
DOCSMIND_VLLM_MODEL=openclaw
DOCSMIND_VLLM_BASE_URL=https://your-vllm-host.example/v1
DOCSMIND_VLLM_API_KEY=replace-with-vllm-api-key
DOCSMIND_VLLM_TIMEOUT_SECONDS=300

# Self-hosted embedding model (downloaded on first run; runs on CPU or GPU).
DOCSMIND_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Use CPU when vLLM reserves most of the beast GPU.
# DOCSMIND_EMBED_DEVICE=cpu

# FAISS index type. Phase 1 supports "flat"; Phase 2 adds ivf/hnsw/pq.
DOCSMIND_INDEX_TYPE=flat

# Paths
DOCSMIND_DATA_DIR=data/sample_docs
DOCSMIND_INDEX_DIR=data/index

# Private WhatsApp corpus (optional). Generate an anonymized *.whatsapp.jsonl
# file with `make prepare-whatsapp WHATSAPP_ZIP=/path/to/export.zip`, then set:
# DOCSMIND_DATA_DIR=data/private/whatsapp
DOCSMIND_WHATSAPP_WINDOW_MINUTES=10
DOCSMIND_WHATSAPP_MAX_MESSAGES=20

# Retrieval / chunking
DOCSMIND_TOP_K=4
DOCSMIND_CHUNK_SIZE=512
DOCSMIND_CHUNK_OVERLAP=64

# Generation
DOCSMIND_MAX_TOKENS=1024
